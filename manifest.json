{
  "manifest_version": 3,
  "name": "Lumen Glass New Tab",
  "version": "1.2.1",
  "description": "A polished liquid-glass new tab with a cinematic, video-reactive YouTube ambient light.",
  "permissions": ["bookmarks", "topSites", "storage", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["youtube-ambient.css"],
      "js": ["youtube-ambient.js"],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Lumen Glass"
  }
}
