{
  "manifest_version": 3,
  "name": "Lumen Glass New Tab",
  "version": "1.1.0",
  "description": "A polished liquid-glass new tab with search, bookmarks, and frequently visited sites.",
  "permissions": ["bookmarks", "topSites", "storage"],
  "host_permissions": ["https://*.google.com/*", "https://*.google.co.kr/*"],
  "content_scripts": [
    {
      "matches": ["https://*.google.com/*", "https://*.google.co.kr/*"],
      "css": ["google-glass.css"],
      "js": ["wallpaper-physics.js", "liquid-physics.js", "google-glass.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/reference-flow-wallpaper.png"],
      "matches": ["https://*.google.com/*", "https://*.google.co.kr/*"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Lumen Glass"
  }
}
