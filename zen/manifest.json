{
  "manifest_version": 3,
  "name": "Lumen Glass for Zen",
  "version": "1.0.0",
  "description": "Liquid-glass new tabs, Google Search styling, and synchronized YouTube ambient light for Zen Browser.",
  "permissions": ["bookmarks", "topSites", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.google.com/*",
    "https://www.google.co.kr/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["youtube-ambient.css"],
      "js": ["compat.js", "youtube-ambient.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.google.com/*", "https://www.google.co.kr/*"],
      "css": ["google-search-glass.css"],
      "js": ["compat.js", "wallpaper-physics.js", "liquid-physics.js", "google-search-glass.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/reference-flow-wallpaper.png"],
      "matches": ["https://www.google.com/*", "https://www.google.co.kr/*"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Lumen Glass"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lumen-glass-zen@keystone360.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
