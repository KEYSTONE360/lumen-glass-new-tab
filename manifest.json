{
  "manifest_version": 3,
  "name": "Lumen Glass New Tab",
  "version": "1.4.0",
  "description": "A polished liquid-glass new tab with a cinematic, video-reactive YouTube ambient light.",
  "permissions": ["bookmarks", "topSites", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.google.com/*",
    "https://www.google.co.kr/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["youtube-ambient.css"],
      "js": ["youtube-ambient.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.google.com/*", "https://www.google.co.kr/*"],
      "css": ["google-search-glass.css"],
      "js": ["wallpaper-physics.js", "liquid-physics.js", "google-search-glass.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/reference-flow-wallpaper.png"],
      "matches": ["https://www.google.com/*", "https://www.google.co.kr/*"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Lumen Glass"
  }
}
